# Copiar a .env y cambiar las contraseñas. El archivo .env NO se sube a GitHub.

# PostgreSQL (contenedor smartcity-postgres)
POSTGRES_DB=smartcity
POSTGRES_USER=smartcity
POSTGRES_PASSWORD=cambiar_esto

# Las mismas credenciales con los nombres que usa el ETL de Spark
PG_USER=smartcity
PG_PASSWORD=cambiar_esto

# MongoDB (local o contenedor smartcity-mongo)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=smartcity
